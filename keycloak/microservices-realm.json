{
  "realm": "microservices",
  "enabled": true,
  "accessTokenLifespan": 60,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "auth-microservice",
      "name": "Authentication Microservice",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "auth-microservice-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ]
    }
  ]
}
