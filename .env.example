PORT=3000

# PostgreSQL and the separate photos database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=keycloak
FOTOS_DB_NAME=fotos
FOTOS_DB_USER=fotos_app
FOTOS_DB_PASSWORD=fotos_dev_password

# Keycloak and application
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/microservices
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/microservices
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/microservices/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=auth-microservice
KEYCLOAK_CLIENT_SECRET=auth-microservice-secret
KEYCLOAK_CALLBACK_URL=http://localhost:3000/auth/callback

# Local SeaweedFS credentials; keep these in sync with seaweedfs/s3.json
S3_READ_ACCESS_KEY=horti-readonly
S3_READ_SECRET_KEY=horti-readonly-local-secret
S3_WRITE_ACCESS_KEY=horti-writer
S3_WRITE_SECRET_KEY=horti-writer-local-secret

# InfluxDB initialization
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=influxadmin
DOCKER_INFLUXDB_INIT_PASSWORD=influx_dev_password
DOCKER_INFLUXDB_INIT_ORG=horticultura
DOCKER_INFLUXDB_INIT_BUCKET=horticultura
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=local-influx-admin-token

# Connection settings for clients running inside Docker
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=horticultura
INFLUX_TOKEN=local-influx-admin-token
INFLUX_BUCKET=horticultura
